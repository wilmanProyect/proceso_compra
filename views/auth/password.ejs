<div class="page-head"><div><h1>Cambiar contraseña</h1><p class="muted">Mínimo 8 caracteres.</p></div></div>
<form method="post" action="/cuenta/password" class="card grid" style="max-width:480px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div><label for="actual">Contraseña actual</label><input type="password" id="actual" name="actual" autocomplete="current-password" required></div>
  <div><label for="nueva">Nueva contraseña</label><input type="password" id="nueva" name="nueva" minlength="8" autocomplete="new-password" required></div>
  <div><label for="confirmar">Confirmar nueva contraseña</label><input type="password" id="confirmar" name="confirmar" minlength="8" autocomplete="new-password" required></div>
  <div><button class="btn" type="submit">Guardar</button></div>
</form>
