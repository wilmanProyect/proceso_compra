<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <style>
      @page { size: letter; margin: 12mm; }
      * { box-sizing: border-box; }
      body { font-family: Calibri, Arial, sans-serif; font-size: 11px; color: #111; margin: 0; background: #e9ecea; }
      .hoja { background: #fff; width: 216mm; min-height: 279mm; margin: 16px auto; padding: 12mm; box-shadow: 0 2px 12px rgba(0,0,0,.15); }
      .barra { position: sticky; top: 0; background: #183c32; color: #fff; padding: 8px 16px; display: flex; gap: 12px; align-items: center; justify-content: center; font-family: system-ui, sans-serif; font-size: 14px; }
      .barra button, .barra a { background: #fff; color: #183c32; border: 0; border-radius: 6px; padding: 6px 14px; font-weight: 700; cursor: pointer; text-decoration: none; font-size: 13px; }
      table { width: 100%; border-collapse: collapse; }
      th, td { border: 1px solid #333; padding: 3px 5px; vertical-align: top; }
      th { background: #eef0ee; font-weight: 700; text-align: center; }
      .sin-borde td, .sin-borde th, td.sb { border: 0; }
      .cab td { vertical-align: middle; }
      .cab .logo { width: 28%; text-align: center; }
      .cab .logo img { max-height: 60px; max-width: 170px; }
      .cab .titulo { text-align: center; font-size: 17px; font-weight: 700; }
      .cab .codigo { width: 22%; font-size: 10px; }
      .seccion { font-weight: 700; margin: 10px 0 3px; font-size: 11.5px; }
      .etq { font-weight: 700; white-space: nowrap; width: 1%; }
      .right { text-align: right; }
      .center { text-align: center; }
      .pre { white-space: pre-wrap; }
      .firmas-print { display: grid; gap: 14px; margin-top: 18px; }
      .firmas-print .f { border: 1px solid #333; }
      .firmas-print .f div { padding: 4px 6px; border-bottom: 1px solid #333; min-height: 22px; }
      .firmas-print .f div:last-child { border-bottom: 0; background: #d9dcda; font-weight: 700; text-align: center; }
      .firmas-print .titulo-f { text-align: center; font-weight: 700; }
      .digital { color: #0a6b3a; font-size: 9.5px; }
      .pie { margin-top: 14px; display: flex; justify-content: space-between; font-size: 9px; color: #444; border-top: 1px solid #999; padding-top: 4px; }
      .tabla-print th { font-size: 9.5px; }
      .caja { display: inline-block; width: 11px; height: 11px; border: 1px solid #333; vertical-align: middle; text-align: center; line-height: 10px; font-size: 10px; margin: 0 4px; }
      @media print {
        body { background: #fff; }
        .barra { display: none; }
        .hoja { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
      }
    </style>
  </head>
  <body>
    <div class="barra">
      <span><%= title %></span>
      <button type="button" id="btn-imprimir">Imprimir / Guardar PDF</button>
      <a href="<%= locals.volver || ('/procesos/' + p.id) %>"><%= locals.volverTexto || 'Volver al proceso' %></a>
    </div>
    <div class="hoja">
      <%- body %>
      <div class="pie">
        <% const unidadPie = locals.cabUnidad || p; %>
        <span>CC: Archivo de control de Calidad de <%= unidadPie.unidad_nombre %> · Rev. documento <%= unidadPie.codigo_revision %></span>
        <span>Las firmas registradas en el sistema tienen validez como aprobación. Impreso: <%= fmt.fechaHora(new Date()) %></span>
      </div>
    </div>
    <script>document.getElementById('btn-imprimir').addEventListener('click', function () { window.print(); });</script>
  </body>
</html>
